# 元聊 YuanChat — 环境变量配置示例
# 复制此文件为 .env 并修改
# 环境变量会覆盖 config.yaml 中的同名配置

# 服务
YUANCHAT_SERVER_ENV=development
YUANCHAT_SERVER_PORT=8080

# 数据库
YUANCHAT_DATABASE_HOST=localhost
YUANCHAT_DATABASE_PORT=5432
YUANCHAT_DATABASE_USER=yuanchat
YUANCHAT_DATABASE_PASSWORD=yuanchat_dev
YUANCHAT_DATABASE_DBNAME=yuanchat

# Redis
YUANCHAT_REDIS_HOST=localhost
YUANCHAT_REDIS_PORT=6379
YUANCHAT_REDIS_PASSWORD=

# JWT
YUANCHAT_JWT_SECRET=change-me-in-production-use-a-long-random-string
