# 前置 nginx：TLS 终止 + 五域名反向代理
#
# 由 install.sh 用 envsubst 把 ${DOMAIN_*} 替换后生成 nginx.conf。
# 首次签发证书前 certbot 需要 HTTP-01 challenge，故 80 端口先放行
# /.well-known/acme-challenge/ 再整体跳转 HTTPS。

upstream yuanchat_api  { server yuanchat-server:8085; }
upstream yuanchat_ws   { server yuanchat-server:8086; }
upstream yuanchat_app  { server yuanchat-web:80; }
upstream yuanchat_adm  { server yuanchat-admin:80; }
upstream yuanchat_s3   { server minio:9000; }

# ---------- HTTP：ACME 校验 + 全站跳 HTTPS ----------
server {
    listen 80;
    server_name ${DOMAIN_CHAT} ${DOMAIN_API} ${DOMAIN_WS} ${DOMAIN_ADMIN} ${DOMAIN_STORAGE};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- app：Web 端 ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_CHAT};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_CHAT}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_CHAT}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    location / {
        proxy_pass http://yuanchat_app;
        include /etc/nginx/proxy-params.conf;
    }
}

# ---------- api：REST ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_API};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_API}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_API}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    # 文件上传走预签名直传 MinIO，此处只需容纳普通 JSON 请求
    client_max_body_size 2m;

    location / {
        proxy_pass http://yuanchat_api;
        include /etc/nginx/proxy-params.conf;
    }
}

# ---------- ws：WebSocket ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_WS};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_WS}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_WS}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    location / {
        proxy_pass http://yuanchat_ws;
        include /etc/nginx/proxy-params.conf;

        # WebSocket 升级
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # 客户端心跳最长 300s（后台低电档），读超时须大于它否则误断
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
    }
}

# ---------- admin：管理后台 ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_ADMIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_ADMIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_ADMIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    location / {
        proxy_pass http://yuanchat_adm;
        include /etc/nginx/proxy-params.conf;
    }
}

# ---------- storage：MinIO 对象存储对外端点 ----------
# 预签名 URL 的 SigV4 签名覆盖 Host 头，故必须透传 $host 且
# MINIO_SERVER_URL 与本域名一致，否则签名校验失败。
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_STORAGE};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_STORAGE}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_STORAGE}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    # 图片/语音/视频经预签名 URL 直传，须容纳与后端 upload.max_file_size 相当的体积。
    # 已核对 server/config/config.yaml:72 的 max_file_size = 104857600（100MB），两者一致；
    # 后端调大上限时这里必须同步，否则本块会成为新的上传截断点（大视频传到一半 413）。
    client_max_body_size 100m;

    location / {
        proxy_pass http://yuanchat_s3;
        # Host 由 proxy-params.conf 统一设成 $host —— 这里**绝对不能**再写一遍
        # proxy_set_header Host：nginx 对同名 proxy_set_header 不去重，会真的发出两个
        # Host 头，而 MinIO 的 Go net/http 在进到 MinIO 自己的 handler 之前就以
        # 「too many Host headers」回 15 字节纯文本 400。表现极具误导性：所有路径
        # （连 /minio/health/live）全是 400，MinIO 日志里一条都没有，容器内直连却正常。
        # 改通用参数时若要去掉那边的 Host，请改 proxy-params.conf，不要在此补一行。
        include /etc/nginx/proxy-params.conf;
    }
}
