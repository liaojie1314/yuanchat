# 元聊 YuanChat 生产环境配置
# 复制为 deploy/.env 后修改（install.sh 会校验必填项）
# ⚠️ .env 含明文凭据，已在 .gitignore 中；勿提交

# ---------- 域名（须已解析到本机公网 IP）----------
DOMAIN_APP=app.yuanchat.example.com
DOMAIN_API=api.yuanchat.example.com
DOMAIN_WS=ws.yuanchat.example.com
DOMAIN_ADMIN=admin.yuanchat.example.com
# 对象存储对外域名：客户端下载图片/语音/视频/头像都走它。
# nginx 反代到内网 minio:9000，同时是 MINIO_SERVER_URL 与后端
# YUANCHAT_MINIO_PUBLIC_ENDPOINT 的取值，三者必须一致（预签名签名覆盖 Host 头）
DOMAIN_STORAGE=storage.yuanchat.example.com

# Let's Encrypt 通知邮箱（证书到期提醒）
ADMIN_EMAIL=admin@yuanchat.example.com

# ---------- 管理后台首个账号 ----------
# 管理后台没有注册入口，首次部署必须由这里引导出第一个管理员，
# 否则装完没人能登进 admin 子域，只能手工改库提权。
# 手机号自己填（登录账号就是它）；密码留空则由 install.sh 随机生成并写回本文件。
# 库里已存在管理员时 install.sh 会跳过，重跑不会重置既有密码。
ADMIN_PHONE=
ADMIN_PASSWORD=

# ---------- 验证码下发通道 ----------
# 注册与找回密码的验证码靠它发出去。provider 可选：
#   log    —— 只把验证码写进服务端日志，仅开发用。**线上用它等于验证码永远收不到，且不报错**
#   smtp   —— 任意邮箱服务商（QQ / 163 / Gmail / 企业邮），推荐，零成本零审核
#   resend —— Resend 的 HTTP API（免费档 3000 封/月、100 封/日，需自有域名并验证）
# 填了未支持的值进程会启动失败，这是故意的：静默退回日志通道等于验证码永远发不出去。
# 为什么不是短信：个人开发者拿不到国内短信签名（必须企业主体），详见 docs/deploy/sms.md
CODESENDER_PROVIDER=log

# --- provider=smtp 用下面四项 ---
# QQ:  smtp.qq.com    163: smtp.163.com    Gmail: smtp.gmail.com
CODESENDER_HOST=
# 465 = 隐式 TLS（推荐），587 = STARTTLS。**不要填 25**，云厂商基本都封了出站 25
CODESENDER_PORT=465
# 登录名，留空则取 CODESENDER_FROM（QQ / 163 的登录名就是邮箱地址本身）
CODESENDER_USERNAME=
# **授权码**，不是邮箱登录密码。QQ: 设置→账号→开启 SMTP 服务后生成；163: 设置→开启 SMTP→授权密码
# 填成登录密码的表现是「注册页一直转圈」，前端完全看不出是发信认证失败
CODESENDER_PASSWORD=

# --- provider=resend 用这项 ---
CODESENDER_API_KEY=

# 发件地址。smtp 填自己的邮箱即可；resend 要求域名已在服务商处验证，否则发信被 403
CODESENDER_FROM=
# 验证码邮件标题，留空取默认值「验证码」
CODESENDER_SUBJECT=


# ---------- 凭据（install.sh 可自动生成随机值）----------
DB_USER=yuanchat
DB_PASSWORD=
DB_NAME=yuanchat
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GRAFANA_PASSWORD=
# TURN 密钥：coturn 与后端共用这一个值（两边不同值则所有通话都认证失败），
# 故只有这一个变量，切勿另开第二个
TURN_SECRET=

# ---------- 通话中继（coturn）----------
# 【必填】本机外网 IP。NAT / 云主机后面无法自动探测（`ip addr` 看到的是内网地址），
# 不填 coturn 会把内网地址写进 relay candidate，跨 NAT 通话卡在「连接中」。
# 查看：curl -s https://api.ipify.org
PUBLIC_IP=

# ---------- Web Push（可选）----------
# 生成：docker compose -f deploy/docker-compose.prod.yml run --rm --entrypoint /app/genvapid yuanchat-server
# 或本地：cd server && go run ./cmd/genvapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- 其他 ----------
# local=单实例；多实例部署改 redis（跨实例 presence 同步）
PRESENCE_BACKEND=local
# 自建镜像 tag：必须显式写已发布的版本号，禁止 latest
#（compose 里用 ${APP_VERSION:?...}，未设置会直接报错退出，避免部署到未知版本）
APP_VERSION=0.5.0
TZ=Asia/Shanghai
