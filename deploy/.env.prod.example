# 元聊 YuanChat 生产环境配置
# 复制为 deploy/.env 后修改（install.sh 会校验必填项）
# ⚠️ .env 含明文凭据，已在 .gitignore 中；勿提交

# ---------- 域名（须已解析到本机公网 IP）----------
DOMAIN_APP=app.yuanchat.example.com
DOMAIN_API=api.yuanchat.example.com
DOMAIN_WS=ws.yuanchat.example.com
DOMAIN_ADMIN=admin.yuanchat.example.com

# Let's Encrypt 通知邮箱（证书到期提醒）
ADMIN_EMAIL=admin@yuanchat.example.com

# ---------- 凭据（install.sh 可自动生成随机值）----------
DB_USER=yuanchat
DB_PASSWORD=
DB_NAME=yuanchat
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GRAFANA_PASSWORD=

# ---------- Web Push（可选）----------
# 生成：docker compose -f deploy/docker-compose.prod.yml run --rm --entrypoint /app/genvapid yuanchat-server
# 或本地：cd server && go run ./cmd/genvapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- 其他 ----------
# local=单实例；多实例部署改 redis（跨实例 presence 同步）
PRESENCE_BACKEND=local
APP_VERSION=latest
TZ=Asia/Shanghai
