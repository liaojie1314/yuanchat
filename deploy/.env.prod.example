# 元聊 YuanChat 生产环境配置
# 复制为 deploy/.env 后修改（install.sh 会校验必填项）
# ⚠️ .env 含明文凭据，已在 .gitignore 中；勿提交

# ---------- 域名（须已解析到本机公网 IP）----------
DOMAIN_APP=app.yuanchat.example.com
DOMAIN_API=api.yuanchat.example.com
DOMAIN_WS=ws.yuanchat.example.com
DOMAIN_ADMIN=admin.yuanchat.example.com
# 对象存储对外域名：客户端下载图片/语音/视频/头像都走它。
# nginx 反代到内网 minio:9000，同时是 MINIO_SERVER_URL 与后端
# YUANCHAT_MINIO_PUBLIC_ENDPOINT 的取值，三者必须一致（预签名签名覆盖 Host 头）
DOMAIN_STORAGE=storage.yuanchat.example.com

# Let's Encrypt 通知邮箱（证书到期提醒）
ADMIN_EMAIL=admin@yuanchat.example.com

# ---------- 凭据（install.sh 可自动生成随机值）----------
DB_USER=yuanchat
DB_PASSWORD=
DB_NAME=yuanchat
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GRAFANA_PASSWORD=
# TURN 密钥：coturn 与后端共用这一个值（两边不同值则所有通话都认证失败），
# 故只有这一个变量，切勿另开第二个
TURN_SECRET=

# ---------- 通话中继（coturn）----------
# 【必填】本机外网 IP。NAT / 云主机后面无法自动探测（`ip addr` 看到的是内网地址），
# 不填 coturn 会把内网地址写进 relay candidate，跨 NAT 通话卡在「连接中」。
# 查看：curl -s https://api.ipify.org
PUBLIC_IP=

# ---------- Web Push（可选）----------
# 生成：docker compose -f deploy/docker-compose.prod.yml run --rm --entrypoint /app/genvapid yuanchat-server
# 或本地：cd server && go run ./cmd/genvapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- 其他 ----------
# local=单实例；多实例部署改 redis（跨实例 presence 同步）
PRESENCE_BACKEND=local
# 自建镜像 tag：必须显式写已发布的版本号，禁止 latest
#（compose 里用 ${APP_VERSION:?...}，未设置会直接报错退出，避免部署到未知版本）
APP_VERSION=0.3.0
TZ=Asia/Shanghai
