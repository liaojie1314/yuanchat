{
  "annotations": {
    "list": []
  },
  "description": "元聊 YuanChat 服务总览。标题刻意不叫 YuanChat —— 与 dashboard.yml 的 folder 同名时 Grafana 会以「Dashboard name cannot be the same as folder」拒绝置备，且只写进容器日志，界面上是一片空白。 数据源直接写死 uid=yuanchat-prom：从 UI 导出的 JSON 会带 ${DS_PROMETHEUS} 占位符与 __inputs，文件置备不做替换，面板会因解析不到数据源而整块不渲染。",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "yuanchat-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"],
          "sortBy": "Max",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "expr": "sum(rate(yuanchat_http_requests_total[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "title": "HTTP QPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "yuanchat-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(yuanchat_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(yuanchat_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(yuanchat_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "title": "HTTP Latency P50/P95/P99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "yuanchat-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "yuanchat_ws_connections_active",
          "legendFormat": "Active"
        }
      ],
      "title": "WS Active Connections",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "yuanchat-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "options": {
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(yuanchat_ws_dispatch_published_total[1m]))",
          "legendFormat": "{{type}}"
        }
      ],
      "title": "WS 分发消息/秒",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "yuanchat-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "options": {
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(yuanchat_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(yuanchat_http_requests_total[5m]))",
          "legendFormat": "5xx 占比"
        }
      ],
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["yuanchat"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "title": "服务总览",
  "uid": "yuanchat-main",
  "version": 1,
  "templating": {
    "list": [
      {
        "hide": 2,
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  }
}
