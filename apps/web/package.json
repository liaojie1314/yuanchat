{
  "name": "@yuanchat/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:mock": "vite --port 5173",
    "dev:real": "VITE_ENABLE_MOCK=false vite --port 5173",
    "dev:test": "vite --port 5173 --mode test",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@yuanchat/design-system": "workspace:*",
    "@yuanchat/shared": "workspace:*",
    "@yuanchat/ui": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "msw": "^2.14.6",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
