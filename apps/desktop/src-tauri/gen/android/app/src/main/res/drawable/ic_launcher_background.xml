<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：品牌渐变，色标与 design-system 的 .brand-gradient 一致。
  Android 的 angle 从东向逆时针计数，315 等价于 CSS 的 linear-gradient(135deg，左上→右下)；
  该值必须是 45 的倍数，否则运行期直接抛 XmlPullParserException。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#5B9BD5"
        android:centerColor="#7EC8E3"
        android:endColor="#A8CFFF"
        android:type="linear" />
</shape>
