{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android-ota",
  "description": "Android 仅允许下载元聊官方 GitHub Release 安装包及其 CDN 重定向。",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/repos/liaojie1314/yuanchat/releases/assets/*" },
        {
          "url": "https://release-assets.githubusercontent.com/github-production-release-asset/1267114250/*"
        }
      ]
    }
  ]
}
