<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 通话权限用途说明。

  为什么必须有这个文件：macOS 的 TCC 在进程首次触碰麦克风/摄像头时会去取对应的
  用途说明字符串，取不到就直接 SIGABRT 掉进程 —— 不是弹窗被拒、也不是
  getUserMedia 抛异常，而是整个 app 崩掉，连 catch 的机会都没有。
  即 CallView / callActions 里那套「取不到设备就 toast」的兜底在这里根本来不及跑。

  为什么放在这个目录：tauri-build 只会自动发现与 tauri.conf.json 同目录、且名为
  Info.plist 的文件。dev 模式下（未打成 .app、二进制裸跑）靠 embed_info_plist!
  把内容塞进 __TEXT,__info_plist 段，而那段代码只认这个固定路径、不看
  bundle.macOS.infoPlist 配置项。换名或挪走会让 pnpm dev 下的通话重新崩溃。
-->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>元聊需要使用麦克风，以便你在语音通话和视频通话中说话。</string>
	<key>NSCameraUsageDescription</key>
	<string>元聊需要使用摄像头，以便你在视频通话中出现画面。</string>
</dict>
</plist>
